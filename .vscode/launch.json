{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Uvicorn: main:app",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["main:app"],
            "subProcess": false,
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "jinja": true
        },
        {
            "name": "DB: migrate + upgrade",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts.py",
            "args": ["db:upgrade"],
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "preLaunchTask": "db:migrate"
        }
    ]
}
