{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Uvicorn: main:app",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["main:app", "--reload"],
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
