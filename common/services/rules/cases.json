{
  "description": "Examples every rule evaluator must pass: the Python one (cx-api/common/services/rules, tests/test_rule_engine.py) and the TypeScript one (cx-front/utils/rules, e2e/rule-engine.spec.ts). Each case gives a rule, optional data, and either the result or \"error\": true for a malformed rule. Numbers compare by value, so 3 matches 3.0. Add a case here whenever either evaluator changes.",
  "cases": [
    { "name": "null literal", "rule": null, "result": null },
    { "name": "number literal", "rule": 4.5, "result": 4.5 },
    { "name": "string literal", "rule": "hello", "result": "hello" },
    { "name": "boolean literal", "rule": true, "result": true },
    { "name": "a list evaluates each item", "rule": [1, { "var": "a" }, "x"], "data": { "a": 2 }, "result": [1, 2, "x"] },

    { "name": "var reads a key", "rule": { "var": "nps" }, "data": { "nps": 9 }, "result": 9 },
    { "name": "var with a one-item list", "rule": { "var": ["nps"] }, "data": { "nps": 9 }, "result": 9 },
    { "name": "var reads a dotted path", "rule": { "var": "answers.q1" }, "data": { "answers": { "q1": "Good" } }, "result": "Good" },
    { "name": "var reads a list index", "rule": { "var": "items.1" }, "data": { "items": ["a", "b"] }, "result": "b" },
    { "name": "var index out of range is null", "rule": { "var": "items.5" }, "data": { "items": ["a"] }, "result": null },
    { "name": "var index must be canonical", "rule": { "var": "items.01" }, "data": { "items": ["a", "b"] }, "result": null },
    { "name": "var negative index is null", "rule": { "var": "items.-1" }, "data": { "items": ["a", "b"] }, "result": null },
    { "name": "var index with a trailing newline is null", "rule": { "var": "items.1\n" }, "data": { "items": ["a", "b"] }, "result": null },
    { "name": "var missing key is null", "rule": { "var": "nope" }, "data": { "a": 1 }, "result": null },
    { "name": "var through a non-object is null", "rule": { "var": "a.b" }, "data": { "a": 5 }, "result": null },
    { "name": "var default for a missing key", "rule": { "var": ["nope", 3] }, "data": {}, "result": 3 },
    { "name": "var default for a null value", "rule": { "var": ["a", "x"] }, "data": { "a": null }, "result": "x" },
    { "name": "var keeps a falsy value", "rule": { "var": ["a", 7] }, "data": { "a": 0 }, "result": 0 },
    { "name": "var empty path is the whole data", "rule": { "var": "" }, "data": { "a": 1 }, "result": { "a": 1 } },
    { "name": "var numeric path", "rule": { "var": 1 }, "data": ["a", "b"], "result": "b" },
    { "name": "var computed path", "rule": { "var": { "if": [true, "a", "b"] } }, "data": { "a": 1, "b": 2 }, "result": 1 },
    { "name": "var non-string path is null", "rule": { "var": [[1]] }, "data": { "1": 5 }, "result": null },
    { "name": "var does not read the prototype", "rule": { "var": "constructor" }, "data": {}, "result": null },
    { "name": "var does not read __proto__", "rule": { "var": "__proto__" }, "data": {}, "result": null },
    { "name": "var does not read a string's length", "rule": { "var": "s.length" }, "data": { "s": "abc" }, "result": null },
    { "name": "var with no data is null", "rule": { "var": "a" }, "result": null },

    { "name": "and all true", "rule": { "and": [true, 1, "x"] }, "result": true },
    { "name": "and one false", "rule": { "and": [true, 0] }, "result": false },
    { "name": "and is always a boolean", "rule": { "and": ["x", 5] }, "result": true },
    { "name": "and single argument", "rule": { "and": [[]] }, "result": false },
    { "name": "or one true", "rule": { "or": [false, null, "y"] }, "result": true },
    { "name": "or all false", "rule": { "or": [0, "", []] }, "result": false },
    { "name": "not true", "rule": { "not": true }, "result": false },
    { "name": "not empty list", "rule": { "not": [[]] }, "result": true },
    { "name": "not empty object is false", "rule": { "not": { "var": "o" } }, "data": { "o": {} }, "result": false },
    { "name": "not of zero", "rule": { "not": 0 }, "result": true },

    { "name": "if then", "rule": { "if": [true, "yes", "no"] }, "result": "yes" },
    { "name": "if else", "rule": { "if": [false, "yes", "no"] }, "result": "no" },
    { "name": "if chain", "rule": { "if": [false, 1, { "==": [1, 1] }, 2, 3] }, "result": 2 },
    { "name": "if without else is null", "rule": { "if": [false, 1] }, "result": null },
    { "name": "if chain without else", "rule": { "if": [false, 1, 0, 2] }, "result": null },
    { "name": "if NPS band", "rule": { "if": [{ ">=": [{ "var": "nps" }, 9] }, "promoter", { ">=": [{ "var": "nps" }, 7] }, "passive", "detractor"] }, "data": { "nps": 8 }, "result": "passive" },

    { "name": "== numbers", "rule": { "==": [1, 1.0] }, "result": true },
    { "name": "== no string to number", "rule": { "==": ["1", 1] }, "result": false },
    { "name": "== no boolean to number", "rule": { "==": [true, 1] }, "result": false },
    { "name": "== booleans", "rule": { "==": [false, false] }, "result": true },
    { "name": "== nulls", "rule": { "==": [null, null] }, "result": true },
    { "name": "== null is not zero", "rule": { "==": [null, 0] }, "result": false },
    { "name": "== null is not empty string", "rule": { "==": [null, ""] }, "result": false },
    { "name": "== missing var equals null", "rule": { "==": [{ "var": "x" }, null] }, "result": true },
    { "name": "== lists deep", "rule": { "==": [{ "var": "a" }, ["x", 1]] }, "data": { "a": ["x", 1.0] }, "result": true },
    { "name": "== lists order matters", "rule": { "==": [["a", "b"], ["b", "a"]] }, "result": false },
    { "name": "== objects deep", "rule": { "==": [{ "var": "a" }, { "var": "b" }] }, "data": { "a": { "x": 1, "y": [2] }, "b": { "y": [2], "x": 1 } }, "result": true },
    { "name": "== objects differ", "rule": { "==": [{ "var": "a" }, { "var": "b" }] }, "data": { "a": { "x": 1 }, "b": { "x": 1, "y": 2 } }, "result": false },
    { "name": "!= strings", "rule": { "!=": ["a", "b"] }, "result": true },
    { "name": "!= same", "rule": { "!=": [2, 2] }, "result": false },

    { "name": "< numbers", "rule": { "<": [{ "var": "score" }, 3] }, "data": { "score": 2 }, "result": true },
    { "name": "< equal is false", "rule": { "<": [3, 3] }, "result": false },
    { "name": "<= equal", "rule": { "<=": [3, 3] }, "result": true },
    { "name": "> numbers", "rule": { ">": [4, 3.5] }, "result": true },
    { "name": ">= numbers", "rule": { ">=": [3, 4] }, "result": false },
    { "name": "< between", "rule": { "<": [1, { "var": "x" }, 10] }, "data": { "x": 5 }, "result": true },
    { "name": "< between at the edge", "rule": { "<": [1, 1, 10] }, "result": false },
    { "name": "<= range inclusive", "rule": { "<=": [1, { "var": "x" }, 10] }, "data": { "x": 10 }, "result": true },
    { "name": "<= range outside", "rule": { "<=": [1, 11, 10] }, "result": false },
    { "name": "< strings by code point", "rule": { "<": ["apple", "banana"] }, "result": true },
    { "name": "< uppercase before lowercase", "rule": { "<": ["Z", "a"] }, "result": true },
    { "name": "< ISO dates", "rule": { "<": [{ "var": "d" }, "2026-06-01"] }, "data": { "d": "2026-05-31" }, "result": true },
    { "name": "< astral characters by code point", "rule": { "<": ["￿", "😀"] }, "result": true },
    { "name": "< number and string is false", "rule": { "<": [1, "2"] }, "result": false },
    { "name": "> number and string is false", "rule": { ">": ["2", 1] }, "result": false },
    { "name": "< null is false", "rule": { "<": [null, 1] }, "result": false },
    { "name": ">= null is false", "rule": { ">=": [{ "var": "missing" }, 0] }, "result": false },
    { "name": "< booleans are not ordered", "rule": { "<": [false, true] }, "result": false },
    { "name": "< lists are not ordered", "rule": { "<": [[1], [2]] }, "result": false },

    { "name": "+ adds", "rule": { "+": [1, 2, 3.5] }, "result": 6.5 },
    { "name": "+ single argument", "rule": { "+": 4 }, "result": 4 },
